{
  "name": "@line-13/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LINE 13 web client: the browser becomes an abandoned telephone exchange.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "e2e": "playwright test",
    "check:transpile": "bun build src/main.tsx --target=browser --external \"*\" --outdir .transpile-check"
  },
  "dependencies": {
    "@line-13/contracts": "0.1.0",
    "@line-13/graph": "0.1.0",
    "@line-13/haunting": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
